#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 4, rgba16f) uniform image2D OutputImage;

layout(set = 0, binding = 5) uniform Camera {
    mat4 inverseViewMatrix;
    mat4 inverseProjectionMatrix;
} cam;

layout (binding = 11) uniform samplerCube samplerReflectiveCubeMap[2];
layout(binding  = 12 ) uniform sampler2D PositionImage;
layout(binding  = 13 ) uniform sampler2D NormalImage;
layout(binding  = 14 ) uniform sampler2D MaterialImage;

layout(push_constant) uniform PushConstants {
    int SkyboxIndex;    
    int EnableReflections;
    int Padding;
    int Padding2;
} pc;

struct Payload {
    vec3 Color;
    float Distance;
    vec3 Normal;
};

layout(location = 0) rayPayloadEXT Payload payload;

void main() {
    const uint rayFlags = gl_RayFlagsOpaqueEXT;
    const uint cullMask = 0xFF;
    const float tMin = 0.001;
    const float tMax = 1000.0;

    ivec2 halfCoord  = ivec2(gl_LaunchIDEXT.xy);
    ivec2 fullCoord = halfCoord;

    vec3 camPos = (cam.inverseViewMatrix * vec4(0.0, 0.0, 0.0, 1.0)).xyz;

    vec3 hitPosition   = texelFetch(PositionImage  , fullCoord, 0).xyz;
    vec3 hitNormal     = texelFetch(NormalImage    , fullCoord, 0).xyz;
    vec3 hitMaterial   = texelFetch(MaterialImage  , fullCoord, 0).xyz;

    bool isGeometry = length(hitNormal) > 0.5;

   vec3 ReflectionColor;

    if (hitMaterial.g < 0.3 && isGeometry && pc.EnableReflections != 0 ) {

        // offset the origin slightly along the normal to avoid self-intersection
        vec3 rayOrigin = hitPosition + hitNormal * 0.038;
        
        // compute incident direction (from camera towards hit point)
        vec3 incident = normalize(hitPosition - camPos);
        
        // reflection direction
        vec3 rayDir = normalize(reflect(incident, hitNormal));
        
        // initialize payload (trace will overwrite fields if hit/miss shaders write)
        payload.Color = vec3(0.0);
        payload.Distance = 0.0;
        payload.Normal = vec3(0.0);
        
        // trace reflection ray
        traceRayEXT(topLevelAS, rayFlags, cullMask, 0, 0, 0, rayOrigin, tMin, rayDir, tMax, 0);
        
        // if the hit shader set a distance > 0 we use payload color, otherwise sample skybox with rayDir
        if (payload.Distance > 0.0) {
            ReflectionColor = payload.Color;
        } else {
            ReflectionColor = texture(samplerReflectiveCubeMap[pc.SkyboxIndex], rayDir).rgb;
        } 

    }else{
        ReflectionColor = vec3(0.0);
    }

    imageStore(OutputImage, halfCoord, vec4(ReflectionColor, 1.0));
}
