#version 450

layout(binding = 1, rgba16f)  uniform image2D  Iradiance;
layout(binding = 2, rgba16f)  uniform image2D  Visibility;
layout(binding = 3, rgba16f)  uniform image2D  Radiance_Visibility;

layout(push_constant) uniform PushConstants {
    int   AtlasWidthSize;  
    int   ProbeSideLength; 
    int   GutterSize;      
    int   NumRays;
}pc;

const int PROBE_STATE_ACTIVE   = 0; //  this is for when a probe is activly collecting new scene data
const int PROBE_STATE_SLEEP    = 1; //  this is for when a probe is always hitting the skybox
const int PROBE_STATE_DISABLED = 2; //  this is for when a probe is inside an object and is not contributing meaningfully.
//A probe that is disabled can be moved so it is active

struct ProbeInformation {
    vec4 probeLocations;
    int  probeState;
    vec3 Padding;
};

layout(set = 0,binding = 0) buffer StorageBufferObject {
      ProbeInformation  ProbeData[];
}SBO;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
                                                                                                                                     //               
float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

vec3 randomOffset(uint probeIndex, float scale) {
    // use probe index as seed
    float seed = float(probeIndex);
    float rx = hash11(seed + 0.1) * 2.0 - 1.0;
    float ry = hash11(seed + 0.2) * 2.0 - 1.0;
    float rz = hash11(seed + 0.3) * 2.0 - 1.0;
    return vec3(rx, ry, rz) * scale;
}

int get_probe_index_from_pixels(uvec2 pixel_coords, int atlas_width, int probe_full_size) {
    
    int   probes_per_row      = atlas_width  / probe_full_size; // How many probes can  be fit in one row of the atlas
    uvec2 probe_grid_coords   = pixel_coords / probe_full_size; // What probe in the atlas am i in ?

  return int(probe_grid_coords.y * probes_per_row + probe_grid_coords.x);
}

shared float visibilityAccum[64];

void main() 
{
   
    if (gl_LocalInvocationIndex == 0) {
        
        int ProbeSideLength_With_Gutter = pc.ProbeSideLength + pc.GutterSize;

        // Find out which probe this 8x8 group is working on
        int probeIndex = get_probe_index_from_pixels(ivec2(gl_WorkGroupID.xy * 8), pc.AtlasWidthSize,ProbeSideLength_With_Gutter);

        // Check buffer bounds
        int numProbes = SBO.ProbeData.length();
        if (probeIndex >= numProbes) {
            return;
        }


        int skyHits = 0;
        int insideHits = 0;

        const float SkyDistance    = 900.0;
        const float Inside         = 0.1;

        // Get the raw Distance traveled of the ray 
        for (int RayIndex = 0; RayIndex < pc.NumRays; RayIndex++) {
            
            ivec2 TexCoord = ivec2(RayIndex, probeIndex);
           
            float Distance = imageLoad(Radiance_Visibility, TexCoord).a;

            if (Distance > SkyDistance) {
                skyHits++;
            }
            else if (Distance < Inside) {
                insideHits++;
            }
        }

        float SkyPercent    = float(skyHits)    / float(pc.NumRays);
        float InsidePercent = float(insideHits) / float(pc.NumRays);

        const float SLEEP_THRESHOLD    = 0.95; 
        const float DISABLE_THRESHOLD  = 0.90; 

        const float WAKE_THRESHOLD     = 0.85; 
        const float ENABLE_THRESHOLD   = 0.80; 

        ProbeInformation probe = SBO.ProbeData[probeIndex];
        int currentState = probe.probeState;

        if (currentState == PROBE_STATE_ACTIVE) {

            if (SkyPercent > SLEEP_THRESHOLD) {

                probe.probeState = PROBE_STATE_SLEEP;

            } else if (InsidePercent > DISABLE_THRESHOLD) {

                probe.probeState = PROBE_STATE_DISABLED;

            }

        } 
        else if (currentState == PROBE_STATE_SLEEP) {

            if (SkyPercent < WAKE_THRESHOLD) { 

                probe.probeState = PROBE_STATE_ACTIVE;

            }
        } 
        else if (currentState == PROBE_STATE_DISABLED) {

            if (InsidePercent < ENABLE_THRESHOLD) {

                probe.probeState = PROBE_STATE_ACTIVE;

            }
        }

        SBO.ProbeData[probeIndex] = probe;
    }
}
